# ------------------- Fire Recorder (NON-BLOCKING) -------------------
class FireRecorder:
    def __init__(self, output_dir, record_duration=10):
        self.output_dir = output_dir
        self.record_duration = record_duration
        self.last_fire_time = 0
        self.is_recording = False
        self.writer = None
        self.current_filename = None
        self.notification_sent_this_event = False
        self.current_detection_id = None
        self.lock = threading.Lock()
        self.frame_queue = Queue(maxsize=100)
        self.recording_thread = None
        self._stop_recording = False
        self._shutdown_event = threading.Event()

    def _recording_worker(self):
        """Worker thread that processes frames from the queue"""
        while not self._shutdown_event.is_set():
            try:
                # Use a timeout to periodically check for shutdown
                item = self.frame_queue.get(timeout=0.5)
                if item is None:  # Shutdown signal
                    break
                frame, writer = item
                if writer and writer.isOpened():
                    writer.write(frame)
                self.frame_queue.task_done()
            except:
                # Timeout or empty queue - check if we should shutdown
                continue

    def update(self, frame, is_confirmed_fire, confidence, cctv_id):
        now = time.time()
        
        if is_confirmed_fire:
            self.last_fire_time = now
            if not self.is_recording:
                with self.lock:
                    if self.is_recording:  # Double check after acquiring lock
                        return
                    self.is_recording = True
                    self._stop_recording = False
                    self._shutdown_event.clear()
                
                timestamp_dt = datetime.now()
                # Insert to DB synchronously but quickly
                try:
                    conn = sqlite3.connect(DB_FILE, check_same_thread=False)
                    cursor = conn.cursor()
                    cursor.execute('INSERT INTO detections (timestamp, confidence, cctv_id) VALUES (?, ?, ?)',
                                (timestamp_dt, confidence, cctv_id))
                    conn.commit()
                    self.current_detection_id = cursor.lastrowid
                    conn.close()
                    print(f"🔥 Fire confirmed! Logged to DB with ID: {self.current_detection_id} for {cctv_id}")
                except Exception as e:
                    print(f"❌ DB insert error: {e}")
                
                timestamp_str = timestamp_dt.strftime("%Y-%m-%d_%H-%M-%S")
                h, w = frame.shape[:2]
                
                # Use CCTV ID in filename - FIRE_CAMERA_001_2024-01-15_14-30-45.avi
                self.current_filename = os.path.join(self.output_dir, f"FIRE_{cctv_id}_{timestamp_str}.avi")
                
                fourcc = cv2.VideoWriter_fourcc(*'MJPG')
                self.writer = cv2.VideoWriter(self.current_filename, fourcc, 20, (w, h))
                
                if not self.writer.isOpened():
                    print(f"❌ Failed to open video writer")
                    with self.lock:
                        self.is_recording = False
                    return
                
                print(f"🎥 Recording started: {self.current_filename}")
                update_db_status('video_path', self.current_detection_id, value=self.current_filename)
                
                # Start recording thread
                self.recording_thread = threading.Thread(target=self._recording_worker, daemon=True)
                self.recording_thread.start()
                
                self.notification_sent_this_event = True
        else:
            if not self.is_recording:
                self.notification_sent_this_event = False
                self.current_detection_id = None

        # Add frame to queue if recording
        if self.is_recording and self.writer and not self._stop_recording:
            try:
                # Don't block if queue is full
                self.frame_queue.put_nowait((frame.copy(), self.writer))
            except:
                # Queue is full, skip this frame
                pass
            
            # Check if recording duration has elapsed
            if now - self.last_fire_time > self.record_duration:
                self.stop()

    def stop(self):
        """Safely stop recording and cleanup resources"""
        print("DEBUG: FireRecorder.stop() called")
        
        with self.lock:
            if not self.is_recording:
                return
                
            self.is_recording = False
            self._stop_recording = True
            self._shutdown_event.set()

        # Wait a moment for the worker thread to finish current operation
        time.sleep(0.1)
        
        # Clear the queue safely
        while not self.frame_queue.empty():
            try:
                self.frame_queue.get_nowait()
                self.frame_queue.task_done()
            except:
                break

        # Close writer safely
        if self.writer:
            try:
                self.writer.release()
            except Exception as e:
                print(f"Warning: Error releasing writer: {e}")
            finally:
                self.writer = None

        # Wait for recording thread to finish
        if self.recording_thread and self.recording_thread.is_alive():
            self.recording_thread.join(timeout=2.0)

        print("ℹ️ Recording stopped.")
        
        # Queue video for upload
        if self.current_filename and os.path.exists(self.current_filename):
            upload_queue.add(self.current_filename)
            print(f"📤 Queued for upload: {self.current_filename}")

