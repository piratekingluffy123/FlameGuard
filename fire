def send_fcm_notification(fcm_token, title, body):
    try:
        payload = {"fcmToken": fcm_token, "title": title, "body": body}
        response = requests.post(FCM_SERVER_URL, json=payload, timeout=10)
        if response.status_code == 200:
            print(f"✅ FCM notification sent to token: {fcm_token[:20]}...")
            return True
        else:
            print(f"❌ Failed to send FCM notification: {response.status_code}")
            return False
    except Exception as e:
        print(f"❌ Error sending FCM notification: {e}")
        return False

def send_bulk_notifications(devices, title, body, detection_id):
    """Send notifications to ALL devices concurrently, but only one SMS per phone"""
    print(f"🚀 Starting concurrent notifications to {len(devices)} devices...")
    start_time = time.time()

    sms_futures = []
    fcm_futures = []
    sms_count = 0
    fcm_count = 0

    # Keep track of unique phones already scheduled for SMS
    unique_phones = set()

    for device in devices:
        phone_number = device.get('phonenumber')
        fcm_token = device.get('fcmToken')

        # FORMAT PHONE AND ENSURE UNIQUE SMS
        formatted_phone = None
        if phone_number and phone_number.strip():
            formatted_phone = format_phone_number(phone_number.strip())
            if formatted_phone in unique_phones:
                formatted_phone = None  # Already scheduled, skip SMS
            elif formatted_phone:
                unique_phones.add(formatted_phone)

        # Submit SMS task if valid
        if formatted_phone:
            future = notification_executor.submit(send_sms, formatted_phone, body)
            sms_futures.append(future)
            sms_count += 1

        # Submit FCM task if token valid
        if fcm_token and fcm_token.strip() and has_internet():
            # Save to Supabase notifications table
            try:
                supabase.table('notifications').insert({
                    'cctv_id': CCTV_ID,
                    'fcm_token': fcm_token,
                    'title': title,
                    'body': body,
                    'type': 'fire',
                    'is_read': False,
                    'created_at': datetime.now().isoformat()
                }).execute()
                print(f"💾 Notification saved to Supabase for token: {fcm_token[:20]}...")
            except Exception as e:
                print(f"❌ Error saving to Supabase for token {fcm_token[:20]}...: {e}")

            future = notification_executor.submit(send_fcm_notification, fcm_token, title, body)
            fcm_futures.append(future)
            fcm_count += 1

    print(f"📱 Submitted {sms_count} SMS and {fcm_count} FCM notifications concurrently")

    # Wait for all SMS to complete
    sms_success = 0
    for future in as_completed(sms_futures):
        try:
            if future.result():
                sms_success += 1
        except Exception as e:
            print(f"❌ SMS task failed: {e}")

    # Wait for all FCM to complete
    fcm_success = 0
    for future in as_completed(fcm_futures):
        try:
            if future.result():
                fcm_success += 1
        except Exception as e:
            print(f"❌ FCM task failed: {e}")

    # Update DB
    if sms_success > 0 and detection_id:
        update_db_status('sms_sent', detection_id)
    if fcm_success > 0 and detection_id:
        update_db_status('push_sent', detection_id)

    elapsed_time = time.time() - start_time
    print(f"✅ Notifications completed in {elapsed_time:.2f}s: {sms_success}/{sms_count} SMS, {fcm_success}/{fcm_count} FCM")

