# ------------------- RTSP Grabber -------------------
class RTSPGrabber(threading.Thread):
    def __init__(self, url):
        super().__init__(daemon=True)
        self.url = url
        self.cap = None
        self.running = True
        self.lock = threading.Lock()
        self.latest_frame = None
        self.connected = False

    def open_capture(self):
        try:
            cap = cv2.VideoCapture(self.url, cv2.CAP_FFMPEG)
        except:
            cap = cv2.VideoCapture(self.url)
        try:
            cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
            cap.set(cv2.CAP_PROP_FRAME_WIDTH, REQUESTED_WIDTH)
            cap.set(cv2.CAP_PROP_FRAME_HEIGHT, REQUESTED_HEIGHT)
            cap.set(cv2.CAP_PROP_FPS, REQUESTED_FPS)
        except:
            pass
        time.sleep(0.3)
        return cap

    def run(self):
        while self.running:
            if self.cap is None or not self.cap.isOpened():
                print("Attempting to open RTSP stream...")
                try:
                    if self.cap:
                        try: self.cap.release()
                        except: pass
                    self.cap = self.open_capture()
                    if self.cap.isOpened():
                        self.connected = True
                        print("RTSP opened.")
                    else:
                        self.connected = False
                        print(f"Failed to open RTSP. Retrying in {RECONNECT_DELAY}s...")
                        time.sleep(RECONNECT_DELAY)
                        continue
                except Exception as e:
                    self.connected = False
                    print("Exception while opening RTSP:", e)
                    time.sleep(RECONNECT_DELAY)
                    continue
            try:
                ret, frame = self.cap.read()
            except Exception as e:
                ret, frame = False, None
            if not ret or frame is None:
                if self.connected:
                    print("Lost frames from RTSP - will reconnect.")
                self.connected = False
                try: self.cap.release()
                except: pass
                time.sleep(RECONNECT_DELAY)
                continue
            with self.lock:
                self.latest_frame = frame
            time.sleep(0.005)

    def get_frame(self):
        with self.lock:
            return None if self.latest_frame is None else self.latest_frame.copy()

    def stop(self):
        self.running = False
        try:
            if self.cap: self.cap.release()
        except: pass

