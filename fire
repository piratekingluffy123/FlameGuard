def run_cloudflare(port):
    tunnel_process = None
    while True:
        if has_internet():
            if tunnel_process is None or tunnel_process.poll() is not None:
                print("🌐 Starting Cloudflare Tunnel...")
                tunnel_process = subprocess.Popen(["cloudflared", "tunnel", "--url", f"http://localhost:{port}"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                public_url = None
                for line in tunnel_process.stdout:
                    match = re.search(r"https://[-a-zA-Z0-9]+\.trycloudflare\.com", line)
                    if match:
                        public_url = match.group(0)
                        print(f"🌍 Public URL: {public_url}/video")
                        break
                # Generate QR code AFTER breaking from the loop
                if public_url:
                    show_qr(f"{public_url}/video", "Cloudflare - ")
        else:
            if tunnel_process:
                tunnel_process.terminate()
                tunnel_process = None
        time.sleep(10)

# ------------------- Main -------------------
if __name__ == '__main__':
    port = 5000
    initialize_database()
    print(f"🔥 Flame Guard Started! CCTV ID: {CCTV_ID}")
    local_ip = get_local_ip()
    print(f"🏠 Local URL: http://{local_ip}:{port}/video")
    show_qr(f"http://{local_ip}:{port}/video", "Local - ")
    threading.Thread(target=process_upload_queue, daemon=True).start()
    threading.Thread(target=run_cloudflare, args=(port,), daemon=True).start()
    try:
        app.run(host='0.0.0.0', port=port, threaded=True)
    except KeyboardInterrupt:
        print("\n🛑 Stopping...")
    finally:
        grabber.stop()
        recorder.stop()
        notification_executor.shutdown(wait=False)
        if ser and ser.is_open: ser.close()
        print("👋 Flame Guard stopped.")