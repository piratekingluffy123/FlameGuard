# ------------------- Frame Generator -------------------
def generate_frames():
    print("Starting MJPEG stream with YOLO detection...")
    avg_fps = []
    last_log_time = time.time()
    LOW_CONF_THRESHOLD = 0.2
    FRAMES_TO_CONFIRM = 12
    fire_persistence_counter = 0

    while True:
        frame = grabber.get_frame()
        if frame is None:
            time.sleep(0.05)
            continue
        start = time.perf_counter()
        try:
            results = model(frame, imgsz=640, verbose=False)
            detections = results[0].boxes
        except Exception as e:
            print(f"YOLO inference error: {e}")
            time.sleep(0.05)
            continue

        fire_detected_this_frame = False
        current_conf_val = 0.0

        for box in detections:
            try:
                cls_id = int(box.cls[0])
                label = labels[cls_id].lower()
                conf = float(box.conf[0])
                if label != "fire" or conf < LOW_CONF_THRESHOLD: continue
                x1, y1, x2, y2 = map(int, box.xyxy[0])
                width, height = x2 - x1, y2 - y1
                if height <= 0 or width < 10 or height < 10: continue
                aspect_ratio = width / height
                if aspect_ratio > 3.5: continue
                fire_region = frame[y1:y2, x1:x2]
                if fire_region.size == 0: continue
                hsv = cv2.cvtColor(fire_region, cv2.COLOR_BGR2HSV)
                mask = cv2.inRange(hsv, (0, 100, 100), (35, 255, 255))
                fire_pixel_ratio = np.sum(mask > 0) / (width * height)
                if fire_pixel_ratio < 0.1: continue
                if np.mean(fire_region) < 100: continue
                fire_detected_this_frame = True
                current_conf_val = conf
                cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 165, 255), 2)
                cv2.putText(frame, f"{label.upper()} {conf:.2f}", (x1, y1 - 5), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 165, 255), 2)
                break
            except: continue

        if fire_detected_this_frame:
            fire_persistence_counter += 1
        else:
            fire_persistence_counter = 0

        is_confirmed_fire = fire_persistence_counter >= FRAMES_TO_CONFIRM
        recorder.update(frame, is_confirmed_fire, current_conf_val)

        fps = 1 / (time.perf_counter() - start)
        avg_fps.append(fps)
        avg_fps = avg_fps[-30:]
        cv2.putText(frame, f"FPS: {np.mean(avg_fps):.1f}", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 0), 2)
        if is_confirmed_fire:
            cv2.putText(frame, f"FIRE DETECTED - {CCTV_ID}", (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)
        status = "CONNECTED" if grabber.connected else "DISCONNECTED"
        cv2.putText(frame, status, (10, 90), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0) if grabber.connected else (0, 0, 255), 2)

        ret, buffer = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 85])
        if not ret: continue
        yield b'--frame\r\nContent-Type: image/jpeg\r\n\r\n' + buffer.tobytes() + b'\r\n'

        if time.time() - last_log_time > 5:
            print(f"📊 Avg FPS: {np.mean(avg_fps):.2f} | Connected: {grabber.connected} | Fire: {fire_persistence_counter}/{FRAMES_TO_CONFIRM}")
            last_log_time = time.time()
        time.sleep(0.01)

