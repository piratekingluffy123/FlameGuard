def send_at(cmd, delay=1):
    """Send AT command - must be called within sms_lock context"""
    if ser is None: 
        return
    try:
        ser.write((cmd + "\r\n").encode())
        time.sleep(delay)
        while ser.in_waiting:
            print(f"[AT-SMS] {ser.readline().decode(errors='ignore').strip()}")
    except Exception as e:
        print(f"Error in send_at({cmd}): {e}")

def format_phone_number(phone):
    """Format phone number to international format"""
    cleaned = re.sub(r'[^\d+]', '', phone)
    
    if cleaned.startswith('09') and len(cleaned) == 11:
        return '+63' + cleaned[1:]
    elif cleaned.startswith('9') and len(cleaned) == 10:
        return '+63' + cleaned
    elif cleaned.startswith('+63') and len(cleaned) == 13:
        return cleaned
    elif cleaned.startswith('63') and len(cleaned) == 12:
        return '+' + cleaned
    else:
        print(f"⚠️ Invalid phone number format: {phone}")
        return None

def send_sms(number, message):
    """Send SMS to a specific phone number with thread-safe serial access"""
    if ser is None:
        print("❌ SMS Failed: Serial port not initialized.")
        return False
    
    # Acquire lock to ensure only one thread uses serial port at a time
    with sms_lock:
        print(f"📠 Sending SMS to {number}...")
        try:
            send_at("AT")
            send_at("ATE0")
            send_at("AT+CMGF=1")
            ser.write(('AT+CMGS="{}"\r\n'.format(number)).encode())
            time.sleep(0.5)
            ser.write((message + "\x1A").encode())
            time.sleep(5)  # Wait for SMS to be sent
            print(f"✅ SMS sent to {number}.")
            return True
        except Exception as e:
            print(f"❌ Failed to send SMS to {number}: {e}")
            return False

